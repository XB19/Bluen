# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env)

# Port HTTP exposé par le site
HTTP_PORT=80
PUBLIC_URL=http://localhost

# Base de données PostgreSQL du conteneur
DB_PASSWORD=

# Secret de signature des jetons (32 caractères minimum, ex : openssl rand -base64 48)
JWT_SECRET=

# Compte administrateur créé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bluen.tg
ADMIN_PASSWORD=

# Notifications par email (devis, messages, candidatures)
NOTIFICATION_EMAIL=contact@bluen.tg
MAIL_FROM=contact@bluen.tg

# Serveur SMTP (optionnel) : décommenter pour activer l'envoi des emails
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
